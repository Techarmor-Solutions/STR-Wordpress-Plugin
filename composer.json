{
    "name": "str-direct-booking/plugin",
    "description": "STR Direct Booking WordPress Plugin",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=8.1",
        "kigkonsult/icalcreator": "^2.41",
        "sentry/sdk": "^4.0",
        "stripe/stripe-php": "^15.0"
    },
    "autoload": {
        "classmap": ["includes/"]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "platform": {
            "php": "8.1.0"
        }
    }
}
