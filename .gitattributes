# Keep non-plugin files out of GitHub release zipballs/tarballs, which the
# plugin updater falls back to when a release has no attached .zip asset.
/license-server     export-ignore
/bin                export-ignore
/.gitattributes     export-ignore
/.gitignore         export-ignore
/package.json       export-ignore
/package-lock.json  export-ignore
/webpack.config.js  export-ignore
